# personalcontentbot: every env var the code reads. Set them in Vercel, never commit real values.
# (Single env example since 2026-10-14; the old env.example was merged in here.)

# ── Supabase (shared hub project) ──
# Public site
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# optional; new-style key instead of the anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# optional; new-style key instead of the service role key
SUPABASE_SECRET_KEY=
PCB_JOBS_TABLE=pcb_jobs
PCB_VIDEO_BUCKET=pcb-videos
# Optional support table name. Default pcb_support_tickets.
PCB_SUPPORT_TABLE=
# Leave unset until supabase/pcb_jobs_durable.sql has been run on the hub.
PCB_DURABLE_JOBS=

# ── Site URL ──
# Public site URL, e.g. https://personalcontentbot.vercel.app
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# ── Apixis ID + Apixis Wallet ──
APIXIS_CLIENT_ID=contentbot
# optional; defaults to <this site>/auth/apixis/callback
APIXIS_REDIRECT_URI=
# Host only: lib/apixis-wallet.ts appends /api/v1/... and /buy. Do NOT add /api/v1 here.
APIXIS_WALLET_API_URL=https://apixis-wallet.vercel.app
# This site's apx_live_ key from the Wallet (npm run family-keys in ApixisWallet). Server only.
WALLET_API_KEY=
# Legacy name for WALLET_API_KEY. Leave unset.
# APIXIS_WALLET_API_KEY=

# ── Video ──
# Optional: Grok Imagine hero clip (first 15s). Falls back to slides on any error.
XAI_API_KEY=
XAI_VIDEO_MODEL=grok-imagine-video-1.5
XAI_VIDEO_RESOLUTION=720p
# Optional video render timeout. Default 150000.
XAI_VIDEO_TIMEOUT_MS=
# PCB_VIDEO_ENGINE=ffmpeg   # force slideshow only
PCB_VIDEO_ENGINE=

# ── Cixy chat + scripts ──
ANTHROPIC_API_KEY=
# Optional model override. Template fallback always works for scripts.
ANTHROPIC_MODEL=

# ── Cron ──
# long random string; Vercel Cron sends it
CRON_SECRET=

# ── Developer scripts only (not Vercel) ──
# SUPABASE_ACCESS_TOKEN=
# VERCEL_TOKEN=
