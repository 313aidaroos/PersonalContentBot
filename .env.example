# personalcontentbot: every env var the code reads. Set them in Vercel (Production), never commit real values.
# Cixy / AI features
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
APIXIS_CLIENT_ID=contentbot
# optional; defaults to <this site>/auth/apixis/callback
APIXIS_REDIRECT_URI=
# optional; older name for WALLET_API_KEY
APIXIS_WALLET_API_KEY=
APIXIS_WALLET_API_URL=https://apixis-wallet.vercel.app
# long random string; Vercel Cron sends it
CRON_SECRET=
# this site's public URL
NEXT_PUBLIC_APP_URL=
# this site's public URL
NEXT_PUBLIC_SITE_URL=
# Supabase anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# optional; new-style key instead of the anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
PCB_DURABLE_JOBS=
PCB_JOBS_TABLE=
PCB_SUPPORT_TABLE=
PCB_VIDEO_BUCKET=
PCB_VIDEO_ENGINE=
# optional; new-style key instead of the service role key
SUPABASE_SECRET_KEY=
# Supabase service role key (server only)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase project URL (server)
SUPABASE_URL=
# this site's apx_live_ key from the Wallet (npm run family-keys -- --only <site>)
WALLET_API_KEY=
XAI_API_KEY=
XAI_VIDEO_MODEL=
XAI_VIDEO_RESOLUTION=
XAI_VIDEO_TIMEOUT_MS=
