# Public site
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never expose
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PCB_JOBS_TABLE=pcb_jobs
PCB_VIDEO_BUCKET=pcb-videos

# Optional: Grok Imagine hero clip (first 15s). Falls back to slides on any error.
XAI_API_KEY=
XAI_VIDEO_MODEL=grok-imagine-video-1.5
XAI_VIDEO_RESOLUTION=720p
# PCB_VIDEO_ENGINE=ffmpeg   # force slideshow only

# Optional: better scripts. Template fallback always works.
ANTHROPIC_API_KEY=

# Optional: Apixis Wallet API for Ixis redemption
APIXIS_WALLET_API_URL=https://apixiswallet.vercel.app/api/v1

# Optional: magic-link token secret (default: dev-secret-change-in-prod)
MAGIC_TOKEN_SECRET=

# ── Added 2026-09-25: keys the code reads that were not listed here ──
# Required
# This site's Apixis Wallet key (apx_live_…). From `npm run family-keys` in ApixisWallet. Server only.
WALLET_API_KEY=
# Optional
# Public site URL, e.g. https://<site>.vercel.app
NEXT_PUBLIC_APP_URL=
# Optional support table name. Default pcb_support_tickets.
PCB_SUPPORT_TABLE=
# Optional video render timeout. Default 150000.
XAI_VIDEO_TIMEOUT_MS=
# Developer scripts only (not Vercel)
# Developer scripts only (Supabase CLI). Not needed on Vercel.
# SUPABASE_ACCESS_TOKEN=
# Developer deploy script only. Not needed on Vercel.
# VERCEL_TOKEN=
# Legacy names (leave unset)
# Legacy name for WALLET_API_KEY. Leave unset.
# APIXIS_WALLET_API_KEY=
