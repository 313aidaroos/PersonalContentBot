# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
DATA_DIR=./data                 # sqlite db + downloaded media live here
DRY_RUN=false                   # true = run pipeline, skip all posting

# ─── LLM (choose one) ────────────────────────────────────────────────────
LLM_PROVIDER=openai             # openai | gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Video: Runway ───────────────────────────────────────────────────────
RUNWAYML_API_SECRET=
RUNWAY_API_BASE=https://api.dev.runwayml.com/v1
RUNWAY_VERSION=2024-11-06
RUNWAY_T2V_MODEL=gen4.5         # text_to_video: gen4.5 | veo3.1 | veo3
RUNWAY_I2V_MODEL=gen4_turbo     # image_to_video: gen4_turbo | gen4.5
RUNWAY_MODE=t2v                 # t2v = prompt only | i2v = keyframe then animate
RUNWAY_MAX_CONCURRENT=2
RUNWAY_POLL_INTERVAL_MS=5000
RUNWAY_TIMEOUT_MS=900000

# ─── Images (keyframes + thumbnails) ─────────────────────────────────────
IMAGE_PROVIDER=openai           # openai (gpt-image-1) | stability | none
STABILITY_API_KEY=

# ─── Voice ───────────────────────────────────────────────────────────────
TTS_PROVIDER=elevenlabs         # elevenlabs | google | none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
GOOGLE_TTS_API_KEY=

# ─── Music ───────────────────────────────────────────────────────────────
PIXABAY_API_KEY=
MUSIC_VOLUME=0.18               # 0-1, ducked under the voiceover

# ─── Assembly ────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
BRAND_INTRO_PATH=               # optional mp4, prepended
BRAND_OUTRO_PATH=               # optional mp4, appended
CAPTION_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ─── Public hosting (REQUIRED for IG/TikTok/Facebook pull-based upload) ──
PUBLIC_UPLOAD_PROVIDER=supabase # supabase | none
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=vidgen-public

# ─── Social platforms ────────────────────────────────────────────────────
ENABLED_PLATFORMS=youtube,tiktok,instagram,facebook,twitter,linkedin
POST_STAGGER_MINUTES=12         # gap between platforms
MAX_POSTS_PER_HOUR_PER_PLATFORM=10

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

INSTAGRAM_USER_ID=              # IG Business account id
INSTAGRAM_ACCESS_TOKEN=

FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=            # e.g. urn:li:organization:12345
